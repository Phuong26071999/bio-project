# Copy to .env.local for local development (never commit real values).
# In production, set these in Vercel → Project → Settings → Environment Variables.
# These are server-only secrets: never prefix them with REACT_APP_.

# --- AI provider ------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
# Lightweight free-tier model (default if unset: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: MINIMAL | LOW | MEDIUM | HIGH (leave empty for the model default)
GEMINI_THINKING_LEVEL=

# "gemini" (default) or "mock" for local testing without a key.
# The mock provider is refused on Vercel production deployments.
CHAT_PROVIDER=gemini

# --- Rate limiting -----------------------------------------------------------
# Shared counters across serverless instances (Upstash Redis free tier, or the
# Upstash integration from the Vercel Marketplace, which sets KV_REST_API_URL /
# KV_REST_API_TOKEN instead — both are supported). Without these, a weaker
# per-instance in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=60
RATE_LIMIT_GLOBAL_PER_DAY=500
# Optional salt for hashing visitor IPs in rate-limit keys
RATE_LIMIT_SALT=

# Optional: extra comma-separated origins allowed to call /api/chat
# (the deployment's own domain is always allowed).
ALLOWED_ORIGINS=
